@page "/signup"
@rendermode InteractiveServer
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Nav

<PageTitle>Sign Up</PageTitle>
<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudCard>
        <MudCardContent>
            <MudText Typo="Typo.h5" Class ="mt-8">Sign Up</MudText>
            @if(!string.IsNullOrEmpty(errorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
            }
            <MudTextField @bind-Value="username" Label="Username" Variant="Variant.Outlined" Class="mb-3" />
            <MudTextField @bind-Value="password" Label="Password" Variant="Variant.Outlined" InputType="InputType.Password" Class="mb-3" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="HandleSignup">
                Sign Up 



                </MudButton>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code{
    private string username = "";
    private string password = "";
    private string errorMessage = "";

    private async Task HandleSignup()
    {
        errorMessage = "";
        var client = HttpClientFactory.CreateClient("HotelAPI");
        var response = await client.PostAsJsonAsync("api/Auth/register", new { username, password });

        if(response.IsSuccessStatusCode)
        {
            Nav.NavigateTo("/login");
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();
            errorMessage = $"Failed: {response.StatusCode} - {error}";
        }
    }
}
