@page "/book/{RoomId:int}"
@rendermode InteractiveServer
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Nav 

<PageTitle>Book Room</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="=mt-8">
    <MudCard>

        <MudCardContent>

            <MudText Typo="Typo.h4" Class="mb-4"Book Room @RoomId></MudText>

            @if(!string.IsNullOrEmpty(errorMessage))
            {
                  <MudAlert Severity="Severity.Error" Class="mb-3">@errorMessage</MudAlert>
            } 
            @if(!string.IsNullOrEmpty(SuccessMessage))
            {
                <MudAlert Severity="Severity.Success"Class="mb-3">@SuccessMessage</MudAlert>
            }
            @*Check IN*@
            <MudDatePicker Label="Check-in-Data"
            @bind-Date="checkIn"
            Variant="Variant.Outlined"
            Class="mb-3"/>
            @*Check out *@
            <MudDatePicker Label="Check-out Date"
                           @bind-Date="checkOut"
                           Variant="Variant.Outlined"
                           Class="mb-3" />
           @if(checkIn.HasValue && checkOut.HasValue && checkOut > checkIn)
           {
                var nights = (checkOut.Value - checkIn.Value).Days;
                <MudText Class="mb-3">
                    Duration: @nights night(s)
                </MudText>
           }
           <MudButton Variant="Variant.Filled"
           Color ="Color.Primary"
                                  FullWidth =" true"
                       Disabled="IsLoading"
                       OnClick="HandleBooking">
               @(IsLoading? "Booking ... " : " Confirm Booking")


           </MudButton>

        </MudCardContent>


    </MudCard>



</MudContainer>



@code 
{
    [Parameter] public int RoomId{ get; set; }
    private DateTime? checkIn;
    private DateTime? checkOut;
    public bool IsLoading = false;
    private string SuccessMessage = "";
    private string errorMessage = "";

    private async Task HandleBooking()
    {
        if(!checkIn.HasValue || !checkOut.HasValue)
        {
            errorMessage = "Select Both Dates Please";
            return;
        }
        if(checkOut <= checkIn)
        {
            errorMessage = "Check out Must after Check in";
            return;
        }
        if(!TokenStore.IsLoggedIn)
        {
            Nav.NavigateTo("/login");
            return;
        }
        IsLoading= true ;
        errorMessage = "";

        var client = HttpClientFactory.CreateClient("HotelAPI");
        client.DefaultRequestHeaders.Authorization =
        new System.Net.Http.Headers.AuthenticationHeaderValue(
            "Bearer", TokenStore.AccessToken);

        var response = await client.PostAsJsonAsync("api/bookings", new
        {
            roomId = RoomId,
            checkIn = checkIn.Value,
            checkOut = checkOut.Value
        });

        if (response.IsSuccessStatusCode)
        {
            SuccessMessage = "Booking confirmed! Redirecting...";
            await Task.Delay(1500); // wait 1.5 seconds so user sees success message
            Nav.NavigateTo("/my-bookings");
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();
            errorMessage = error;
        }

        IsLoading = false;
    }
}