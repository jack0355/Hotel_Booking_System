@page "/admin/all-bookings"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Admin - All Bookings</PageTitle>
<MudText Typo="Typo.h4" GutterBottom="true" Color="Color.Primary">
    📋 All Bookings (Admin)
</MudText>


<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudGrid>
      
        <MudItem xs="12" sm="6" md="3">
            <MudSelect T="string" Label="Status" @bind-Value="selectedStatus" @bind-Value:after="ApplyFilters"
                       Variant="Variant.Outlined">
                <MudSelectItem Value="@("All")">All Statuses</MudSelectItem>
                <MudSelectItem Value="@("Pending")">Pending</MudSelectItem>
                <MudSelectItem Value="@("Confirmed")">Confirmed</MudSelectItem>
                <MudSelectItem Value="@("Cancelled")">Cancelled</MudSelectItem>
            </MudSelect>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudSelect T="string" Label="Room Type" @bind-Value="selectedRoomType"
                       Variant="Variant.Outlined"
                       OnChange="OnFilterChanged">
                <MudSelectItem Value="@("All")">All Types</MudSelectItem>
                <MudSelectItem Value="@("Single")">Single</MudSelectItem>
                <MudSelectItem Value="@("Double")">Double</MudSelectItem>
                <MudSelectItem Value="@("Suite")">Suite</MudSelectItem>
            </MudSelect>
        </MudItem>

       
        <MudItem xs="12" sm="6" md="3">
            <MudDatePicker Label="Check-in From" @bind-Date="dateFrom"
                           Variant="Variant.Outlined"
                           OnDateChanged="OnFilterChanged" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudDatePicker Label="Check-in To" @bind-Date="dateTo"
                           Variant="Variant.Outlined"
                           OnDateChanged="OnFilterChanged" />
        </MudItem>

      
        <MudItem xs="12" sm="6" md="12" Class="d-flex justify-end">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       OnClick="ClearFilters"
                       StartIcon="Icons.Material.Clear">
                Clear Filters
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>




@if (allBookings == null)
{
    <MudProgressCircular Indeterminate="true" />
}

else if(filteredBookings == null || filteredBookings.Count == 0 )
{
<MudAlert Severity="Severity.Info">
    No Bookings found Matching the Current Filters
</MudAlert>    
}


else
{
    <MudTable Items="@filteredBookings" Hover="true" Elevation="2">
        <HeaderContent>
            <MudTh>User</MudTh>
            <MudTh>Room</MudTh>
            <MudTh>Type</MudTh>
            <MudTh>Check-in</MudTh>
            <MudTh>Check-out</MudTh>
            <MudTh>Total</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Action</MudTh>
            <MudTh>Stay Info</MudTh>
        </HeaderContent>


        <RowTemplate>
            <MudTd>
                <MudStack Row="true" Spacing="1">
                    <MudAvatar Size="Size.Small" Text="@GetInitials(context.UserName)" />
                    <MudText Class="mt-1">@context.UserName</MudText>
                </MudStack>
            </MudTd>
            <MudTd>#@context.RoomNumber</MudTd>
            <MudTd>
                <MudChip T="string" Color="Color.Secondary" Size="Size.Small">
                    @context.RoomType
                </MudChip>
            </MudTd>
            <MudTd>@context.CheckIn.ToShortDateString()</MudTd>
            <MudTd>@context.CheckOut.ToShortDateString()</MudTd>
            <MudTd><strong>$@context.TotalPrice</strong></MudTd>
            <MudTd>
                <MudChip T="string" Color="@GetStatusColor(context.Status)" Size="Size.Small">
                    @context.Status
                </MudChip>
           

            </MudTd>





            <MudTd>
                @if (context.Status == "Pending")
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Check"
                               OnClick="() => ApproveBooking(context.Id, context.UserName, context.RoomNumber)">
                        Approve
                    </MudButton>
                }
                @if (context.Status != "Cancelled")
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                               OnClick="() => CancelBooking(context.Id, context.UserName, context.RoomNumber)">
                        Cancel
                    </MudButton>
                }
                @if (context.Status == "Confirmed" && context.CheckedInAt == null)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small"
                               OnClick="() => CheckInGuest(context.Id)">
                        Check In
                    </MudButton>
                }
                @if (context.CheckedInAt != null && context.CheckedOutAt == null)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small"
                               OnClick="() => CheckOutGuest(context.Id)">
                        Check Out
                    </MudButton>
                }
            </MudTd>




            <MudTd>
                @if (context.CheckedInAt != null && context.CheckedOutAt == null)
                {
                    var duration = DateTime.UtcNow - context.CheckedInAt.Value;
                    <MudText Typo="Typo.caption" Color="Color.Info">Checked in @FormatDuration(duration)</MudText>
                }
                @if (context.CheckedOutAt != null)
                {
                    var stayLength = context.CheckedOutAt.Value - context.CheckedInAt!.Value;
                    <MudText Typo="Typo.caption" Color="Color.Default">Stayed @FormatDuration(stayLength)</MudText>
                }
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {

    private List<AdminBookingResponse>? allBookings;
    private List<AdminBookingResponse>? filteredBookings;


    //------------------------------
    // ---------- FILTERS ----------
    //------------------------------
    private string selectedStatus = "All";
    private string selectedRoomType = "All";
    private DateTime? dateFrom;
    private DateTime? dateTo;


    //------------------------------
    // ---------- DTO ----------
    //------------------------------

    public class AdminBookingResponse
    {
        public int Id { get; set; }
        public string RoomNumber { get; set; } = string.Empty;
        public string RoomType { get; set; } = string.Empty;
        public string UserName { get; set; } = string.Empty;      // Who booked it
        public string? UserEmail { get; set; }                   
        public DateTime CheckIn { get; set; }
        public DateTime CheckOut { get; set; }
        public decimal TotalPrice { get; set; }
        public string Status { get; set; } = string.Empty;
        public DateTime? CheckedInAt{ get; set;}
        public DateTime? CheckedOutAt{ get; set;}
    }
    //------------------------------
    // ---------- LIFECYCLE ----------
    //------------------------------
    protected override async Task OnInitializedAsync()
    {
        await LoadAllBookings();
    }
    //------------------------------
    // ---------- LOAD DATA ----------
    //------------------------------
    private async Task LoadAllBookings()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("HotelAPI");
            client.DefaultRequestHeaders.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue(
                    "Bearer", TokenStore.AccessToken);

            allBookings = await client.GetFromJsonAsync<List<AdminBookingResponse>>("api/Bookings/admin/all");

            // Apply filters after loading
            ApplyFilters();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading bookings: {ex.Message}", Severity.Error);
        }
    }
    //------------------------------
    // ---------- FILTERS ----------
    //------------------------------
    private void ApplyFilters()
    {
        if (allBookings == null)
        {
            filteredBookings = null;
            return;
        }

        var query = allBookings.AsEnumerable();


        if (selectedStatus != "All")
        {
            query = query.Where(b => b.Status == selectedStatus);
        }


        if (selectedRoomType != "All")
        {
            query = query.Where(b => b.RoomType == selectedRoomType);
        }


        if (dateFrom.HasValue)
        {
            query = query.Where(b => b.CheckIn >= dateFrom.Value);
        }
        if (dateTo.HasValue)
        {
            query = query.Where(b => b.CheckIn <= dateTo.Value);
        }
        Console.WriteLine($"Filtering Status : '{selectedStatus}' . Found {query.Count()} matches ");
        filteredBookings = query.ToList();
    }


    private void OnFilterChanged(object? value)
    {
        ApplyFilters();
        StateHasChanged(); 
    }

    private void ClearFilters()
    {
        selectedStatus = "All";
        selectedRoomType = "All";
        dateFrom = null;
        dateTo = null;
        ApplyFilters();
        StateHasChanged();
    }

    private async Task CancelBooking(int bookingId, string userName, string roomNumber)
    {
        bool? confirm = await DialogService.ShowMessageBox(
            "Cancel Booking",
            $"Are you sure you want to cancel {userName}'s booking for Room #{roomNumber}?",
            "Yes, Cancel it!",
            "No, Keep it"
        );

        if (confirm == true)
        {
            try
            {
                var client = HttpClientFactory.CreateClient("HotelAPI");
                client.DefaultRequestHeaders.Authorization =
                    new System.Net.Http.Headers.AuthenticationHeaderValue(
                        "Bearer", TokenStore.AccessToken);

                var response = await client.PutAsJsonAsync($"api/Bookings/{bookingId}/cancel", "");

                if (response.IsSuccessStatusCode)
                {
                    Snackbar.Add($"Booking for Room #{roomNumber} cancelled successfully!", Severity.Success);
                    await LoadAllBookings(); // Refresh
                }
                else
                {
                    var error = await response.Content.ReadAsStringAsync();
                    Snackbar.Add($"Failed to cancel: {error}", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Network error: {ex.Message}", Severity.Error);
            }
        }
    }
    //------------------------------
    //-----------APPROVE BOOKING--------------
    //------------------------------
    private async Task ApproveBooking(int bookingId , string userName , string roomNumber)
    {
        bool? confirm = await DialogService.ShowMessageBox("ConfirmBooking",
        $"Are you Sure you want to confirm {userName}'s booking for room #{roomNumber}?"
        , "Yes , Confirm it !",
        "No , Keep it ");

        if(confirm == true)
        {
            try
            {
                var client = HttpClientFactory.CreateClient("HotelAPI");
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue
                ("Bearer", TokenStore.AccessToken);

                var response = await client.PutAsJsonAsync($"api/Bookings/{bookingId}/confirm", "");

                if(response.IsSuccessStatusCode)
                {
                    Snackbar.Add($"Booking For Room #{roomNumber} Confirmed Successfully !" , Severity.Success
                    );
                    await LoadAllBookings();
                }
                else
                {
                    var error = await response.Content.ReadAsStringAsync();
                    Snackbar.Add($"Failed to Confirm : {error}", Severity.Error);
                }
            }
            catch(Exception Ex)
            {
                Snackbar.Add($"NetWork Error : {Ex.Message}", Severity.Error);
            }
        }
    }

    private Color GetStatusColor(string status) => status switch
    {
        "Confirmed" => Color.Success,
        "Pending" => Color.Warning,
        "Cancelled" => Color.Error,
        _ => Color.Default
    };

    private string GetInitials(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
            return "?";

        var parts = fullName.Trim().Split(' ');
        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[1][0]}";
        return fullName.Substring(0, Math.Min(2, fullName.Length)).ToUpper();
    }

    private async Task CheckInGuest(int bookingId)
    {
        var client = HttpClientFactory.CreateClient("HotelAPI");
        client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", TokenStore.AccessToken);


        var response = await client.PutAsJsonAsync($"api/Bookings/{bookingId}/checkin" ,"");
        Console.WriteLine($"Checkin Response : {response.StatusCode}");
        if(response.IsSuccessStatusCode)
        {
            Snackbar.Add("Guest cheked in !", Severity.Success);
            await LoadAllBookings();
        } 
        else
        {
            var error = await response.Content.ReadAsStringAsync();
            Snackbar.Add($"Failed:{error}", Severity.Error);
        }
    }

    private async Task CheckOutGuest(int bookingId)
    {
        var client = HttpClientFactory.CreateClient("HotelAPI");
        client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer",TokenStore.AccessToken);

        var response = await client.PutAsJsonAsync($"api/Bookings/{bookingId}/checkout", "");
        if(response.IsSuccessStatusCode)
        {
            Snackbar.Add("Guest checked out !", Severity.Success);
            await LoadAllBookings();
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();
            Snackbar.Add($"Failed:{error}", Severity.Error);
        }
    }

    private string FormatDuration(TimeSpan span)
    {
        if (span.TotalDays >= 1)
            return $"{(int)span.TotalDays}d {span.Hours}h ago";
        if (span.TotalHours >= 1)
            return $"{(int)span.Hours}h {span.Minutes}m ago";


            return $"{(int)span.TotalMinutes}m ago";
    }

}