@* Pages/Admin/RoomDialog.razor *@
@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h5">@(IsEdit ? "Edit Room" : "Add New Room")</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField Label="Room Number" @bind-Value="roomRequest.Number" />
            <MudTextField Label="Room Type" @bind-Value="roomRequest.Type" />
            <MudNumericField Label="Capacity" @bind-Value="roomRequest.Capacity" Min="1" Max="10" />
            <MudNumericField Label="Price Per Night" @bind-Value="roomRequest.PricePerNight" Min="1" />


            <MudFileUpload T="IBrowserFile" FilesChanged="OnFileSelected" Accept=".jpg, .jpeg , .png">
                <ActivatorContent>
                    <MudButton Variant="Variant.Outlined"
                    Color="Color.Primary"
                    StartIcon="@Icons.Material.Filled.CloudUpload">
                    Upload Room Photo
                    </MudButton>
                </ActivatorContent>

            </MudFileUpload>
            @if(selectedFile != null)
            {
                <MudText Typo="Typo.caption">Selected : @selectedFile.Name</MudText>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="() => MudDialog.Close(DialogResult.Cancel())">
            Cancel
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save"
                   Disabled="isSubmitting">
            @(isSubmitting ? "Saving..." : "Save")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }

    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public RoomResponse? Room { get; set; }

    private RoomRequest roomRequest = new();
    private bool isSubmitting = false;

    private IBrowserFile? selectedFile;
    private void OnFileSelected(IBrowserFile file)
    {
        selectedFile = file;
    }


    protected override void OnInitialized()
    {
        if (IsEdit && Room != null)
        {
            roomRequest = new RoomRequest
            {
                Number = Room.Number,
                Type = Room.Type,
                Capacity = Room.Capacity,
                PricePerNight = Room.PricePerNight
            };
        }
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(roomRequest.Number) ||
            string.IsNullOrWhiteSpace(roomRequest.Type) ||
            roomRequest.Capacity <= 0 ||
            roomRequest.PricePerNight <= 0)
        {
            Snackbar.Add("Please fill all fields correctly.", Severity.Warning);
            return;
        }

        isSubmitting = true;

        try
        {
            var client = HttpClientFactory.CreateClient("HotelAPI");
            client.DefaultRequestHeaders.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue(
                    "Bearer", TokenStore.AccessToken);

            HttpResponseMessage response;
            int roomId;
            if (IsEdit && Room != null)
            {
                response = await client.PutAsJsonAsync($"api/Room/{Room.Id}", roomRequest);
                roomId = Room.Id;
            }
            else
            {
                response = await client.PostAsJsonAsync("api/Room", roomRequest);
                if (response.IsSuccessStatusCode)
                {
                    var created = await response.Content.ReadFromJsonAsync<RoomResponse>();
                    roomId = created?.Id ?? -1;
                }
                else
                {
                    roomId = -1;
                }
            }

            if(!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Error: {error}", Severity.Error);
                return;
            }

            if( roomId > 0  && selectedFile != null)
            {
                await UploadRoomImage(client, roomId);
            }

            MudDialog?.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Network error: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task UploadRoomImage(HttpClient client , int roomId)
    {
        if (selectedFile == null) return;

        using var content = new MultipartFormDataContent();
        using var stream = selectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);

        var fileContent = new StreamContent(stream);

        content.Add(fileContent, "File", selectedFile.Name);

        var response = await client.PostAsync($"api/Room/{roomId}/image", content);

        if(!response.IsSuccessStatusCode)
        {
            var error = await response.Content.ReadAsStringAsync();
            Snackbar.Add($"Image Upload failed : {error}", Severity.Error);
        }
    }
}