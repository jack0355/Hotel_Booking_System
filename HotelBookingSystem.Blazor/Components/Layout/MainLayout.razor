@using MudBlazor
@inject NavigationManager Nav
@inherits LayoutComponentBase

<MudThemeProvider />
<MudDialogProvider />
<MudPopoverProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Primary">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggel())" />
        <MudText Typo="Typo.h6">🏨 Hotel Booking System</MudText>
        <MudSpacer />
        @if (TokenStore.IsLoggedIn)
        {
            <MudText Color="Color.Inherit" Class="mr-3">@TokenStore.Role</MudText>
            <MudButton Color="Color.Inherit" OnClick="Logout">Logout</MudButton>
        }
        else
        {
            <MudButton Color="Color.Inherit" Href="/login">Login</MudButton>
        }
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="2" Variant="DrawerVariant.Responsive">
        <MudNavMenu>
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">
                Home
            </MudNavLink>
            <MudNavLink Href="/rooms" Icon="@Icons.Material.Filled.Hotel">
                Rooms
            </MudNavLink>
            @if(TokenStore.Role != "Admin")
            {
                <MudNavLink Href="/my-bookings" Icon="@Icons.Material.Filled.BookOnline">
                    My Bookings
                </MudNavLink>

            }
          
           
            @if (TokenStore.IsLoggedIn && TokenStore.Role == "Admin")
            {
                <MudNavLink Href="/admin/rooms" Icon="@Icons.Material.Filled.Settings">
                    Manage Rooms
                </MudNavLink>
                <MudNavLink Href="/admin/all-bookings" Icon="@Icons.Material.Filled.Book">
                    All Bookings
                </MudNavLink>
            }
            
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code 
{
    private bool _drawerOpen = true;

    private void DrawerToggel()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void Logout()
    {
        TokenStore.AccessToken = null;
        TokenStore.Role = null;
        Nav.NavigateTo("/login");
    }
}